# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Settings `qmcp.config` reads, credentials among them (QMCP_ALFRED_PASSWORD,
# QMCP_ALFRED_TOKEN); never tracked.
.env

# SQLite databases
*.db

# Metaflow artifacts
.metaflow/

# Excluding the contents rather than the directory: git does not descend
# into an excluded directory, so a negation under `.vscode/` never fires.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# The voice loop writes its audio here (joe-contract convention); never tracked.
Data/

# The session brief /cowork writes; it names this machine's paths.
.harness/
